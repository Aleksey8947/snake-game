{
  "name": "Погодный агент (пример)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "weather",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook (триггер)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "weather-demo"
    },
    {
      "parameters": {
        "jsCode": "// Достаём город из запроса: /webhook/weather?city=Moscow\nconst query = $input.first().json.query || {};\nconst city = (query.city || 'Moscow').toString();\n\n// ID городов OpenWeatherMap (для примера)\nconst cityIds = {\n  moscow: 524901,\n  london: 2643743,\n  newyork: 5128581,\n  dubai: 292223,\n  tokyo: 1850144,\n};\n\nconst id = cityIds[city.toLowerCase()] || 524901;\nreturn [{ json: { city, cityId: id } }];"
      },
      "id": "node-code",
      "name": "Код: разбор города",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://api.openweathermap.org/data/2.5/weather?id={{$json.cityId}}&units=metric&lang=ru&appid=demo_key",
        "options": {}
      },
      "id": "node-http",
      "name": "HTTP Request: погода",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "// Собираем красивый ответ для пользователя\nconst d = $input.first().json;\n\nconst answer = `🌍 ${d.name}: ${d.weather?.[0]?.description || 'нет данных'}, ` +\n  `температура ${d.main?.temp ?? '?'}°C (ощущается как ${d.main?.feels_like ?? '?'}°C), ` +\n  `влажность ${d.main?.humidity ?? '?'}%, ветер ${d.wind?.speed ?? '?'} м/с`;\n\nreturn [{ json: { answer, raw: d } }];"
      },
      "id": "node-format",
      "name": "Код: форматирование ответа",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 0]
    }
  ],
  "connections": {
    "Webhook (триггер)": {
      "main": [[{ "node": "Код: разбор города", "type": "main", "index": 0 }]]
    },
    "Код: разбор города": {
      "main": [[{ "node": "HTTP Request: погода", "type": "main", "index": 0 }]]
    },
    "HTTP Request: погода": {
      "main": [[{ "node": "Код: форматирование ответа", "type": "main", "index": 0 }]]
    },
    "Код: форматирование ответа": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
