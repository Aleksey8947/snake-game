{
  "name": "Погодный агент (без ключей)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "weather",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook (триггер)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "weather-demo"
    },
    {
      "parameters": {
        "jsCode": "// Достаём город из запроса: /webhook/weather?city=Moscow\nconst query = $input.first().json.query || {};\nconst city = (query.city || 'Moscow').toString();\nreturn [{ json: { city } }];"
      },
      "id": "node-code",
      "name": "Код: разбор города",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "url": "=https://wttr.in/{{encodeURIComponent($json.city)}}?format=j1",
        "options": {}
      },
      "id": "node-http",
      "name": "HTTP Request: погода (wttr.in)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "// wttr.in возвращает JSON без ключа API — красиво форматируем ответ\nconst d = $input.first().json;\nconst cur = d.current_condition?.[0] || {};\nconst area = d.nearest_area?.[0] || {};\n\nconst answer = `🌍 ${area.areaName?.[0]?.value || 'Неизвестно'}, ${area.country?.[0]?.value || ''}: ` +\n  `${cur.lang_ru?.[0]?.value || cur.weatherDesc?.[0]?.value || 'нет данных'}, ` +\n  `температура ${cur.temp_C}°C (ощущается как ${cur.FeelsLikeC}°C), ` +\n  `влажность ${cur.humidity}%, ветер ${cur.windspeedKmph} км/ч`;\n\nreturn [{ json: { answer } }];"
      },
      "id": "node-format",
      "name": "Код: форматирование ответа",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [880, 0]
    }
  ],
  "connections": {
    "Webhook (триггер)": {
      "main": [[{ "node": "Код: разбор города", "type": "main", "index": 0 }]]
    },
    "Код: разбор города": {
      "main": [[{ "node": "HTTP Request: погода (wttr.in)", "type": "main", "index": 0 }]]
    },
    "HTTP Request: погода (wttr.in)": {
      "main": [[{ "node": "Код: форматирование ответа", "type": "main", "index": 0 }]]
    },
    "Код: форматирование ответа": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
